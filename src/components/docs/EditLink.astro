---
import type { CollectionEntry } from "astro:content";
import type { SiteConfig } from "../../lib/site";
import { Pencil } from "lucide-react";

export interface Props {
  doc: CollectionEntry<"docs">;
  site: SiteConfig;
}

const { doc, site } = Astro.props;

// nukehub-sync-docs injects the repo-relative source path as `editPath`
// frontmatter (consumers must declare `editPath: z.string().optional()` in
// their docs schema). Fall back to the legacy editPath + doc.id guess.
const syncedEditPath = (doc.data as { editPath?: unknown }).editPath;
const editUrl =
  typeof syncedEditPath === "string" && syncedEditPath
    ? `${site.github}/edit/${site.editBranch}/${syncedEditPath}`
    : `${site.github}/edit/${site.editBranch}/${site.editPath}${doc.id}`;
---

<a
  href={editUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-primary"
>
  <Pencil className="h-3.5 w-3.5" />
  <span>Edit this page on GitHub</span>
</a>
