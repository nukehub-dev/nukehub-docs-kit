---
import "../../styles/global.css";
import type { SiteConfig } from "../../lib/site";
import type { NavItem } from "../../lib/nav";
import { GlobalContextMenu } from "../shared/GlobalContextMenu";

export interface Props {
  site: SiteConfig;
  navItems: NavItem[];
  title?: string;
  description?: string;
}

const { site, navItems, title = site.name, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-accent="orange">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d65a0f" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${site.base}/favicon.svg`}
      data-logo-paths={site.faviconPaths}
    />
    <!-- Dynamic favicon: updates to the current theme accent once CSS variables are available. -->
    <script>
      import { updateFavicon, updateMetaThemeColor } from "../../lib/theme";
      updateFavicon();
      updateMetaThemeColor();
    </script>
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var preference = localStorage.getItem("docs-theme") || "system";
          var accent = localStorage.getItem("docs-accent") || "orange";
          var validAccents = ["red", "orange", "green", "cyan", "purple"];
          if (validAccents.indexOf(accent) === -1) accent = "orange";
          var resolved =
            preference === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
              : preference;
          document.documentElement.setAttribute("data-theme", resolved);
          document.documentElement.setAttribute("data-accent", accent);

          var metaColors = {
            red: { light: "#e03131", dark: "#c92a2a" },
            orange: { light: "#f37524", dark: "#d65a0f" },
            green: { light: "#40c057", dark: "#2f9e44" },
            cyan: { light: "#15aabf", dark: "#1098ad" },
            purple: { light: "#be4bdb", dark: "#9c36b5" },
          };
          var color = (metaColors[accent] || metaColors.orange)[resolved];

          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute("content", color);
          }

          var defaultLogoPaths =
            '<g transform="matrix(3.1345855,0,0,3.1681526,-1119.1055,-1093.7635)">' +
            '<path opacity="0.75" fill="currentColor" d="m 385.12,463.48 c -4.44,13.5 -25.32,10.98 -24.58,-4.84 q 0.44,-9.43 4.73,-20.45 c 16.22,-41.66 43.4,-67.32 82.87,-86.81 6.57,-3.23 16,-4.4 21.9,0.25 5.87,4.63 5.15,14.67 0.11,19.81 q -2.01,2.05 -7.97,4.65 c -31.59,13.76 -60.02,40.66 -72.02,72.97 q -2.65,7.16 -5.04,14.42 z"/>' +
            '<path opacity="0.55" fill="currentColor" d="m 580.69,375.81 c -8.55,-5.25 -6.46,-18.71 1.13,-23.07 6.21,-3.57 12.23,-1.85 18.21,1.5 36.82,20.65 69.97,55.47 81.05,96.48 1.62,5.99 0.63,13.94 -4.29,18.16 -6.47,5.53 -16.75,4.78 -20.87,-3.61 q -1.25,-2.54 -4.15,-11.45 c -9.63,-29.5 -29.11,-51.99 -55.74,-68.53 q -7.66,-4.75 -15.34,-9.48 z"/>' +
            '<path opacity="0.85" fill="currentColor" d="m 451.17,494.48 c -14.33,-0.17 -28.77,-0.93 -43.06,-0.06 q -0.49,0.03 -0.45,-0.46 c 1.7,-19.31 7.65,-39.22 19.23,-54.92 12.16,-16.48 28.66,-31.06 47.76,-38.88 q 16.05,-6.58 33.29,-9.43 q 0.51,-0.08 0.5,0.43 l -0.29,44.63 a 0.67,0.67 0 0 1 -0.65,0.66 q -3.51,0.14 -6.78,1.21 c -26.17,8.65 -44.06,28.88 -48.96,56.32 q -0.09,0.5 -0.59,0.5 z"/>' +
            '<path opacity="0.65" fill="currentColor" d="m 532.87,436.7 a 0.53,0.53 0 0 1 -0.42,-0.53 l 0.17,-44.11 q 0.01,-0.48 0.49,-0.44 38.83,3.68 66.19,31.05 10.82,10.83 19.09,23.67 c 9.72,15.09 12.84,30.4 14.66,48.33 q 0.06,0.55 -0.49,0.51 q -22.65,-1.59 -45.33,-0.63 q -0.53,0.02 -0.62,-0.5 c -1.97,-11.27 -5.31,-22.23 -12.18,-31.28 Q 559.21,442.74 532.87,436.7 Z"/>' +
            '<path opacity="1" fill="currentColor" d="m 486.45,544.05 c -29.77,-27.76 -18.47,-74.32 19.6,-86.26 15.79,-4.95 34.04,-0.2 46.42,10.55 19.84,17.25 21.61,44.46 7.24,66.3 -16.4,24.94 -51.06,30.11 -73.26,9.41 z m 39.37,-44.52 a 17.6,17.6 0 0 0 -17.6,-17.6 17.6,17.6 0 0 0 -17.6,17.6 17.6,17.6 0 0 0 17.6,17.6 17.6,17.6 0 0 0 17.6,-17.6 z"/>' +
            '<path opacity="0.45" fill="currentColor" d="m 633.48,518.74 a 0.37,0.37 0 0 1 0.35,0.4 c -4.98,56.3 -45.11,97.31 -100.96,104.1 q -0.28,0.03 -0.28,-0.26 l -0.12,-45.12 a 0.7,0.7 0 0 1 0.53,-0.68 c 28.34,-7.07 48.76,-28.83 52.71,-57.94 a 0.58,0.57 2.3 0 1 0.55,-0.5 q 23.61,-1.07 47.22,0 z"/>' +
            '<path opacity="0.6" fill="currentColor" d="m 486.73,617.78 c -43.89,-14.64 -74.82,-51.87 -78.6,-98.46 q -0.04,-0.48 0.44,-0.49 18.71,-0.38 37.43,-0.34 2.66,0 5.29,0.35 q 0.49,0.07 0.53,0.55 c 2.95,28.92 29.37,51.88 56,58.18 q 0.38,0.09 0.39,0.49 l 0.33,44.69 q 0,0.46 -0.45,0.36 q -14.33,-2.99 -21.36,-5.33 z"/>' +
            '<path opacity="0.5" fill="currentColor" d="m 443.36,660.71 c -35.69,-19.39 -67.56,-50.9 -81.31,-89.23 -1.72,-4.8 -3.6,-10.45 -2.27,-15.38 q 2.48,-9.17 11.91,-10.16 c 7.83,-0.82 12,3.87 14.26,10.85 q 4.39,13.56 14.66,28.92 c 16.87,25.23 38.11,40.65 64.92,54.16 15.45,7.78 8.04,27.95 -7.79,25.88 q -6.73,-0.89 -14.38,-5.04 z"/>' +
            '<path opacity="0.4" fill="currentColor" d="m 587.87,665.74 c -5.5,-0.8 -11.2,-4.91 -12.2,-10.7 -1.66,-9.57 2.87,-13.24 10.96,-17.83 30.8,-17.47 56.29,-41.82 66.53,-76.66 q 2.2,-7.46 3.79,-9.5 c 3.35,-4.27 8.78,-5.73 14.1,-4.55 14.04,3.14 10.56,17.53 6.89,27.99 -13.54,38.63 -40.24,65.15 -74.67,86.01 -4.92,2.97 -9.83,6.06 -15.4,5.24 z"/>' +
            "</g>";
          var link = document.querySelector("link[rel='icon'][type='image/svg+xml']");
          var logoPaths = (link && link.getAttribute("data-logo-paths")) || defaultLogoPaths;
          var svg =
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><g style="color: ' +
            color +
            '">' +
            logoPaths +
            "</g></svg>";
          var dataUrl =
            "data:image/svg+xml," +
            encodeURIComponent(svg).replace(/'/g, "%27").replace(/"/g, "%22");
          if (link) {
            link.href = dataUrl;
          }
        } catch {
          document.documentElement.setAttribute("data-theme", "dark");
          document.documentElement.setAttribute("data-accent", "orange");
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <GlobalContextMenu navItems={navItems} client:load />
    <slot />
    <script is:inline>
      (function () {
        const copyIcon =
          '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/></svg>' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><path d="M20 6 9 17l-5-5"/></svg>';

        function initCopyButtons() {
          document.querySelectorAll(".prose pre").forEach(function (pre) {
            if (pre.querySelector(".code-copy-button")) return;
            const code = pre.querySelector("code");
            if (!code) return;
            const text = code.textContent || "";
            const button = document.createElement("button");
            button.type = "button";
            button.className = "code-copy-button";
            button.setAttribute("aria-label", "Copy code");
            button.innerHTML = copyIcon;
            button.addEventListener("click", function () {
              navigator.clipboard.writeText(text).catch(function () {});
              button.classList.add("copied");
              button.setAttribute("aria-label", "Copied!");
              window.setTimeout(function () {
                button.classList.remove("copied");
                button.setAttribute("aria-label", "Copy code");
              }, 2000);
            });
            pre.appendChild(button);
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initCopyButtons);
        } else {
          initCopyButtons();
        }
      })();
    </script>
  </body>
</html>
